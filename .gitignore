# Secrets. Only the template is committed.
#
# Deliberately stricter than the Next.js convention. Next treats .env.production
# and .env.development as committed files for non-secret defaults, and only
# gitignores the .local variants — so `.env.production` containing a database
# password would be committed silently, which is the opposite of what the name
# suggests to most people. Everything matching .env* is ignored here, and the
# template is the single exception.
.env*
!.env.example

# Drizzle
drizzle/meta/_journal.json.bak

.DS_Store
*.pem
npm-debug.log*
tsconfig.tsbuildinfo
next-env.d.ts
