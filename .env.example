# Neon Postgres — the pooled connection string from the Neon console.
# Use the `dev` database branch locally and `main` in production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (managed Better Auth). Found under Auth in the Neon console once
# auth is enabled on the project.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"

# Signs the session cookie. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Public sign-up is closed by default — this is an internal finance tool.
# Set a value here to let someone self-register with it; leave empty to allow
# account creation only through /admin/users.
INVITE_TOKEN=""

# Origin this app is served from — Neon Auth requires it on sign-up requests,
# and it must be listed in the Neon Console's trusted origins in production.
APP_ORIGIN="http://localhost:3000"
